# ---------------------------------------------------------------------------
# Insider-Copy Paper Trading Bot — example environment file.
# Copy to `.env` and fill in the blanks. `.env` is git-ignored; never commit it.
# Ship with live trading DISABLED. Leave live keys blank.
# ---------------------------------------------------------------------------

# --- SEC EDGAR ---------------------------------------------------------------
# REQUIRED by the SEC. Without a real User-Agent EDGAR returns HTTP 403.
# Format: "Your Name your.email@domain.com"
SEC_USER_AGENT=

# --- Alpaca (PAPER) ----------------------------------------------------------
# Get these from https://app.alpaca.markets/ -> Paper Trading -> API Keys.
# These are PAPER keys. Do NOT put live keys here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoint. Do not change unless you know exactly what you are doing.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Safety gates ------------------------------------------------------------
# DRY_RUN=true  -> log intended orders, place nothing (default, safe).
# DRY_RUN=false -> actually place PAPER orders.
DRY_RUN=true
# Live-trading gate. Must be "true" AND CONFIRM_LIVE=true to ever touch live.
# Keep both false. There are intentionally no live keys in this file.
ALLOW_LIVE=false
CONFIRM_LIVE=false

# --- Notifications (optional) ------------------------------------------------
# If unset, notifications fall back to structured logs only.
SLACK_WEBHOOK_URL=

# --- Strategy tunables (defaults sized for a $200 paper account) -------------
STARTING_EQUITY=200
DOLLARS_PER_POSITION=25
MAX_OPEN_POSITIONS=8
MAX_DAILY_LOSS_PCT=10
MIN_INSIDER_BUY_USD=50000
CLUSTER_MIN_INSIDERS=2
CLUSTER_WINDOW_DAYS=5
MIN_PRICE=5.0
MIN_AVG_DOLLAR_VOLUME=1000000
TRAIL_PCT=10
HARD_STOP_PCT=15
MAX_HOLD_DAYS=20
MAX_POSITION_EQUITY_PCT=20

# --- Runtime -----------------------------------------------------------------
# Path to the SQLite state DB.
DB_PATH=data/trader.db
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Timezone used for scheduling (market is US/Eastern).
SCHEDULE_TZ=America/New_York
